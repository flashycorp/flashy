APP_ENV=local               # local | dev | staging | production
APP_PORT=8080
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=text             # text локально, json на окружениях

# База данных
DATABASE_URL=postgres://flashy:change-me@localhost:5432/flashy?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Аутентификация
JWT_SECRET=change-me-to-long-random-string
JWT_TTL_MINUTES=60

# CORS (адрес фронтенда)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=